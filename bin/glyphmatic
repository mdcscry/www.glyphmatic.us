#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DOC_MAN = ROOT / 'docs' / 'man' / 'glyphmatic.us.md'
DOC_OVERVIEW = ROOT / 'docs' / 'glyphmatic-overview.md'

HELP_TEXT = """glyphmatic.us — browser-first generative Unicode art

USAGE
  bin/glyphmatic --help
  bin/glyphmatic man
  bin/glyphmatic overview
  bin/glyphmatic inventory
  bin/glyphmatic qa
  bin/glyphmatic preview [preview args...]

DESCRIPTION
  Glyphmatic is a browser-first generative Unicode art project built around
  g.us3.htm, modular insert files, shared font/palette engines, and a large
  body of historical experiments.

CORE PATHS
  host page        g.us3.htm
  host config      js_funct/insert_config.js
  nav panel        js_funct/nav_menu.js
  palettes         js_funct/colorpalette.js
  autofont         js_funct/autoFont.js
  modern inserts   insert_js_2025/
  legacy inserts   insert_js_2013/
  experiments      2025_exp/ 2026_exp/
  tools            bin/

COMMON COMMANDS
  bin/glyphmatic inventory
      Show registered inserts, files, and short descriptions.

  bin/glyphmatic qa
      Run structural QA against host/config/insert files.

  bin/glyphmatic preview --index 29 --flavor 3
      Generate a local preview URL for an insert/flavor.

  bin/glyphmatic preview --serve --index 34 --open
      Serve the repo locally and open a preview on macOS.

  bin/glyphmatic man
      Print the full man-page-style reference.

WORKFLOWS
  Inspect the repo:
      bin/glyphmatic inventory
      bin/glyphmatic qa

  Preview an insert locally:
      bin/glyphmatic preview --serve --index 29 --flavor 3 --open

  Find the important docs:
      bin/glyphmatic overview
      bin/glyphmatic man

NOTES
  - No build step is assumed.
  - Preserve watermark/nav host elements in insert work.
  - Avoid wiping document.body inside inserts.
  - Multi-flavor inserts should clean up timers/listeners/DOM roots.
"""


def print_help():
    print(HELP_TEXT.rstrip())


def print_file(path: Path):
    if not path.exists():
        print(f'missing file: {path}')
        return 1
    print(path.read_text(encoding='utf-8').rstrip())
    return 0


def run_python_script(script_name: str, argv):
    script = ROOT / 'bin' / script_name
    if not script.exists():
        print(f'missing script: {script}')
        return 1
    return subprocess.call([sys.executable, str(script)] + argv, cwd=str(ROOT))


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    if not argv or argv[0] in ('-h', '--help', 'help'):
        print_help()
        return 0

    cmd = argv[0]
    rest = argv[1:]

    if cmd == 'man':
        return print_file(DOC_MAN)
    if cmd == 'overview':
        return print_file(DOC_OVERVIEW)
    if cmd == 'inventory':
        return run_python_script('glyphmatic_inventory.py', rest)
    if cmd == 'qa':
        return run_python_script('glyphmatic_insert_qa.py', rest)
    if cmd == 'preview':
        return run_python_script('glyphmatic_preview.py', rest)
    if cmd == 'root':
        print(str(ROOT))
        return 0

    print(f'Unknown command: {cmd}')
    print('Run `bin/glyphmatic --help` for usage.')
    return 1


if __name__ == '__main__':
    raise SystemExit(main())
